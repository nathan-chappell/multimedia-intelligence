OPENAI_API_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173","http://127.0.0.1:5173","https://localhost:8000","https://127.0.0.1:8000"]
COUPON_CODE_PEPPER=replace-with-a-long-random-secret
BILLING_MARKUP_MULTIPLIER=1.5
BILLING_PRICING_VERSION=demo-2026-08
OPENAI_DICTATION_MODEL=gpt-4o-mini-transcribe
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
MAX_DICTATION_BYTES=26214400
MAX_MEDIA_TRANSCRIPTION_BYTES=26214400
# Agents SDK traces are exported to the OpenAI platform by default. Prompt, output,
# tool argument, and tool result content remain excluded unless explicitly enabled.
OPENAI_TRACING_ENABLED=true
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Railway Bucket credentials. Use the bucket's Variables → Add Reference flow.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual
OBJECT_STORE_PREFIX=assets/
SIGNED_DOWNLOAD_TTL_SECONDS=900

MAX_UPLOAD_BYTES=5368709120
MAX_DIRECT_CONTEXT_BYTES=65536
MAX_PROVIDER_FILE_BYTES=536870912
MAX_VISION_PDF_BYTES=41943040
MAX_JSON_PROBE_BYTES=16384
MAX_CLIENT_TOOL_RESULT_BYTES=262144
CHATKIT_MAX_PAGE_SIZE=100
# Comma-separated JSON may be supplied through CORS_ORIGINS for fixed production
# origins. In development, localhost and RFC1918 LAN origins are also accepted.
CORS_ORIGINS=["http://localhost:5173"]
FRAME_INTERVAL_SECONDS=30

APP_ENV=development
VITE_CHATKIT_API_URL=/chatkit
VITE_CHATKIT_API_DOMAIN_KEY=domain_pk_localhost_dev
VITE_CLERK_PUBLISHABLE_KEY=
