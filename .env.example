OPENAI_API_KEY=
ADMIN_USER_ID=user_admin
ADMIN_USERNAME=admin
ADMIN_BEARER_TOKEN=local-development-admin-token
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Agents SDK traces are exported to the OpenAI platform by default. Prompt, output,
# tool argument, and tool result content remain excluded unless explicitly enabled.
OPENAI_TRACING_ENABLED=true
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ATTACHMENT_DIR=./data/attachments

# Railway Bucket credentials. Use the bucket's Variables → Add Reference flow.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual
OBJECT_STORE_PREFIX=assets/
SIGNED_DOWNLOAD_TTL_SECONDS=900

MAX_UPLOAD_BYTES=5368709120
MAX_DIRECT_CONTEXT_BYTES=65536
MAX_PROVIDER_FILE_BYTES=536870912
MAX_VISION_PDF_BYTES=41943040
MAX_JSON_PROBE_BYTES=16384
MAX_CLIENT_TOOL_RESULT_BYTES=262144
CHATKIT_MAX_PAGE_SIZE=100
FRAME_INTERVAL_SECONDS=30
FILE_RETENTION_HOURS=24
EXPIRATION_SWEEP_SECONDS=3600

APP_ENV=development
VITE_CHATKIT_API_URL=/chatkit
VITE_CHATKIT_API_DOMAIN_KEY=domain_pk_localhost_dev
VITE_API_BEARER_TOKEN=local-development-admin-token
