// JMESPath 1.0 grammar translated from https://jmespath.org/specification.html.
// The expression layers encode the specification's binding order.

?start: expression

?expression: pipe_expression
?pipe_expression: or_expression ("|" or_expression)*
?or_expression: and_expression ("||" and_expression)*
?and_expression: comparator_expression ("&&" comparator_expression)*
?comparator_expression: not_expression (COMPARATOR not_expression)?
?not_expression: "!" not_expression
               | postfix_expression

?postfix_expression: primary_expression postfix_part*
?primary_expression: function_expression
                   | identifier
                   | current_node
                   | literal
                   | raw_string
                   | "*"                         -> wildcard
                   | "(" expression ")"         -> paren_expression
                   | bracket_expression
                   | multi_select_hash

postfix_part: "." dot_rhs
            | bracket_specifier

?dot_rhs: function_expression
        | identifier
        | multi_select_list
        | multi_select_hash
        | "*"                                    -> wildcard

?bracket_expression: bracket_specifier
                   | multi_select_list

bracket_specifier: "[" SIGNED_INT "]"            -> index
                 | "[" "*" "]"                 -> list_wildcard
                 | "[" slice_expression "]"      -> slice
                 | FILTER_OPEN expression "]"     -> filter
                 | "[" "]"                     -> flatten

slice_expression: [SIGNED_INT] ":" [SIGNED_INT] [":" [SIGNED_INT]]

multi_select_list: "[" expression ("," expression)* "]"
multi_select_hash: "{" keyval_expr ("," keyval_expr)* "}"
keyval_expr: identifier ":" expression

function_expression: UNQUOTED_STRING "(" [function_arg ("," function_arg)*] ")"
?function_arg: expression_type | expression
expression_type: "&" expression
current_node: "@"

?identifier: UNQUOTED_STRING | QUOTED_STRING
literal: "`" json_value "`"
raw_string: RAW_STRING

?json_value: "false"                              -> json_false
           | "null"                               -> json_null
           | "true"                               -> json_true
           | json_object
           | json_array
           | JSON_NUMBER
           | LITERAL_STRING
json_object: "{" [json_member ("," json_member)*] "}"
json_member: LITERAL_STRING ":" json_value
json_array: "[" [json_value ("," json_value)*] "]"

COMPARATOR: "==" | "!=" | "<=" | ">=" | "<" | ">"
UNQUOTED_STRING: /[A-Za-z_][A-Za-z0-9_]*/
QUOTED_STRING: /"(?:[^"\\\x00-\x1f]|\\(?:["\\\/bfnrt]|u[0-9A-Fa-f]{4}))+"/
LITERAL_STRING: /"(?:[^"\\`\x00-\x1f]|\\(?:["\\\/bfnrt`]|u[0-9A-Fa-f]{4}))*"/
RAW_STRING: /'(?s:[^'\\]|\\.)*'/
FILTER_OPEN: "[?"
SIGNED_INT: /-?(?:0|[1-9][0-9]*)/
JSON_NUMBER: /-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/

%import common.WS
%ignore WS
